procedure TForm1.FillList(Path: string; ListView: TListView; IsFile: Boolean = False);
var
  SR: TSearchRec;
  DirList: TStrings;
  i, fd: Integer;
  li: TListItem;
  d: TDateTime;
  fType: SmallInt;
begin
  DirList := TStringList.Create;
  try
    if FindFirst(Path + '\*', faAnyFile, SR) = 0 then
    begin
      repeat
        if ((SR.Attr and faAnyFile) <> 0) and
          not ((SR.Name = '.') or (SR.Name = '..') or (SR.Name = 'System Volume Information'))
        then
          DirList.Add(SR.Name); //Fill the list
      until FindNext(SR) <> 0;

      FindClose(SR);
    end;

    ListView.Clear;

    for i := 0 to DirList.Count - 1 do
    begin
      li := ListView.Items.Add;
      li.Caption := DirList[i];

      if IsFile then
        fType := faAnyFile
      else
        fType := faDirectory;

      FindFirst(Path + '\' + DirList[i], fType, SR);
      fd := SR.Time;
      d := FileDateToDateTime(fd);

      li.SubItems.Add(DateTimeToStr(d));
    end;
  finally
   DirList.Free;
  end;

  ListView.SortType := stData;
  ListView.AlphaSort;
end;

